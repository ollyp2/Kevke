[Unit]
Description=SotF server agent (metrics, sessions, job queue)
After=docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/sotf-agent.env
ExecStart=/opt/sotf-agent/venv/bin/python /opt/sotf-agent/sotf-agent.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
